{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "mode", "source_roots", "kit_root"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "mode": {"const": "static-only"},
    "kit_root": {"type": "string", "minLength": 1},
    "source_roots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "git_commit", "git_dirty"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "git_commit": {"type": ["string", "null"]},
          "git_dirty": {"type": ["boolean", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
