{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state.schema.json",
  "title": "Investigation checkpoint state",
  "type": "object",
  "required": ["schema_version", "status", "next_actions", "blockers", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["active", "complete", "partial", "blocked"]},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true,
  "$comment": "Complete refers to the agreed review scope, not a proof of vulnerability absence."
}
