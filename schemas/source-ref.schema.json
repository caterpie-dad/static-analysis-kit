{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-ref.schema.json",
  "title": "Source reference in a declared source root",
  "type": "object",
  "required": ["root_id", "path", "start_line", "end_line", "sha256", "symbol", "claim"],
  "properties": {
    "root_id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "start_line": {"type": "integer", "minimum": 1},
    "end_line": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "symbol": {"type": "string"},
    "claim": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true,
  "$comment": "Path containment, file hash and valid line ranges require checking actual source bytes."
}
